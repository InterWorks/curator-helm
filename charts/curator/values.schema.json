{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "required": [
    "curator"
  ],
  "properties": {
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "qa",
        "prod"
      ]
    },
    "curator": {
      "type": "object",
      "required": [
        "database"
      ],
      "properties": {
        "database": {
          "description": "Strict, and the only source of the database connection: every required value must be set explicitly. Nothing falls back to a chart default, so a missing or misspelled key fails the render instead of routing the site to the wrong database.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host",
            "databaseName",
            "username",
            "password"
          ],
          "properties": {
            "connection": {
              "type": [
                "string",
                "null"
              ]
            },
            "host": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "directHost": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
            },
            "port": {
              "type": [
                "integer",
                "string",
                "null"
              ]
            },
            "databaseName": {
              "description": "Also the metadata.name of the site's Database, Grant and Backup CRs (managed outside the chart). The Backup's CronJob takes the same name, and Kubernetes caps CronJob names at 52 characters.",
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 52
            },
            "username": {
              "description": "Also the metadata.name of the site's User CR (managed outside the chart).",
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "maxLength": 80
            },
            "password": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "secretKeyRef"
              ],
              "properties": {
                "secretKeyRef": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "key"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        "cache": {
          "type": "object",
          "properties": {
            "redis": {
              "description": "Shared Redis/Valkey cache (opt-in). Strict, so a misspelled key fails the render instead of leaving the site on a cache it should not use.",
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "host": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
                },
                "port": {
                  "type": [
                    "integer",
                    "string",
                    "null"
                  ]
                },
                "username": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "passwordSecretRef": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "key": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "tls": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "enabled": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "caFile": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "verifyPeer": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
